  "cloudFunctionCallExamples": {
    "description": "Sample requests for calling Firebase Cloud Functions",
    "examples": [
      {
        "function": "registerDeviceToken",
        "request": {
          "userId": "user_12345",
          "token": "fcm_device_token_abc123xyz",
          "platform": "ios",
          "appVersion": "1.0.0"
        }
      },
      {
        "function": "sendNotification",
        "request": {
          "userId": "user_12345",
          "title": "New Event Posted",
          "message": "Medical Conference scheduled for next week",
          "type": "event",
          "priority": "normal",
          "data": {
            "eventId": "event_123",
            "actionType": "navigate",
            "actionScreen": "EventDetail"
          }
        }
      },
      {
        "function": "sendBulkNotifications",
        "request": {
          "userIds": ["user_12345", "user_67890", "user_11111"],
          "title": "System Maintenance",
          "message": "Scheduled maintenance tonight 2-4 AM",
          "type": "alert",
          "priority": "high"
        }
      },
      {
        "function": "scheduleNotification",
        "request": {
          "userId": "user_12345",
          "title": "Event Reminder",
          "message": "Your event starts in 1 hour",
          "type": "reminder",
          "priority": "high",
          "scheduledFor": "2026-03-05T14:00:00Z",
          "data": {
            "eventId": "event_456"
          }
        }
      }
    ]
  }
}
