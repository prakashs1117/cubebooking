{
  "name": "curiosity-booking",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "format": "prettier . --write",
    "generate-apk": "npm run bundle-android && cd android && ./gradlew assembleRelease",
    "bundle-android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --sourcemap-output android/app/src/main/assets/index.android.map --assets-dest android/app/src/main/res/",
    "copy-all--eva-files": "cp -f config/eva/localization.json config/eva/theme.json config/eva/platformconfig.json config/eva/mockdata.json ./",
    "copy-firebase-android-files": "cp -f config/eva/google-services.json ./android/app",
    "android-cache-clear": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "clear_local_gradle_cache": "rm -rf $HOME/.gradle/caches/",
    "clear_build": "rm -rf android/.gradle android/build",
    "clean_gradle": "cd android && ./gradlew clean",
    "nps_start": "npx react-native start --reset-cache",
    "convert-icons": "node scripts/convert-svg-icons.js",
    "apply-icons": "node scripts/apply-app-icons.js",
    "api:local": "node scripts/switch-api.js local",
    "api:ios": "node scripts/switch-api.js ios",
    "api:remote": "node scripts/switch-api.js remote",
    "api:emu": "node scripts/switch-api.js emu",
    "rebrand": "node scripts/rebrand/index.js",
    "rebrand:ios": "node scripts/rebrand/rebrand-ios.js",
    "rebrand:android": "node scripts/rebrand/rebrand-android.js",
    "rebrand:dry": "node scripts/rebrand/index.js --dry-run",
    "rebrand:legacy": "node scripts/rebrand.js",
    "bump": "node scripts/version/bump.js",
    "bump:dry": "node scripts/version/bump.js --dry-run",
    "bump:ios": "node scripts/version/bump-ios.js",
    "bump:android": "node scripts/version/bump-android.js",
    "rename-app": "bash scripts/rename-app.sh",
    "setup:firebase": "node scripts/setup-firebase-configs.js",
    "generate-splash-logo": "node scripts/generate-splash-logo.js",
    "ios:clean-pods": "cd ios && pod deintegrate && pod cache clean --all && pod install",
    "ios:clean-derived": "rm -rf ~/Library/Developer/Xcode/DerivedData",
    "ios:nuke": "npm run ios:clean-derived && npm run ios:clean-pods"
  },
  "dependencies": {
    "@demand/shared": "file:../packages/shared",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-camera-roll/camera-roll": "^7.10.2",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^26.4.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native/new-app-screen": "0.83.1",
    "@react-navigation/bottom-tabs": "^7.9.0",
    "@react-navigation/drawer": "^7.8.1",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.12.0",
    "@react-navigation/stack": "^7.7.2",
    "@shopify/flash-list": "^2.3.1",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "axios": "^1.13.5",
    "i18next": "^26.4.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "react": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-i18next": "^17.0.15",
    "react-native": "0.85.3",
    "react-native-bootsplash": "^7.3.4",
    "react-native-dotenv": "^5.0.0",
    "react-native-gesture-handler": "^3.3.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-inappbrowser-reborn": "^3.7.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-localize": "^3.4.2",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-reanimated": "4.6.0",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-restart": "^0.0.29",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.0",
    "react-native-snap-carousel": "^3.9.1",
    "react-native-svg": "^15.15.5",
    "react-native-toast-message": "^2.3.3",
    "react-native-view-shot": "^6.1.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "^0.12.0",
    "yarn": "^1.22.22",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/eslint-config": "0.85.3",
    "@react-native/gradle-plugin": "0.85.3",
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@react-native/typescript-config": "0.85.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-native-dotenv": "^0.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "react-native-clean-project": "^4.0.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "rnpm": {
    "assets": [
      "./assets/fonts"
    ]
  }
}
