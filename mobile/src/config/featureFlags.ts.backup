/**
 * Environment-specific feature flag overrides
 */
const ENVIRONMENT_OVERRIDES = {
  development: {
    ENABLE_ANALYTICS: false,
    SHOW_DEBUG_INFO: true,
    ENABLE_PERFORMANCE_MONITORING: true,
  },
  staging: {
    ENABLE_ANALYTICS: true,
    SHOW_DEBUG_INFO: false,
    ENABLE_PERFORMANCE_MONITORING: true,
  },
  production: {
    ENABLE_ANALYTICS: true,
    SHOW_DEBUG_INFO: false,
    ENABLE_PERFORMANCE_MONITORING: false,
  },
};

/**
 * Get the current environment
 */
const getCurrentEnvironment = (): 'development' | 'staging' | 'production' => {
  if (__DEV__) return 'development';
  // Add logic here to detect staging vs production
  // This could be based on bundle identifier, API endpoints, etc.
  return 'production';
};

/**
 * Get feature flag value with environment overrides
 */
export const getFeatureFlagValue = (flagKey: FeatureFlagKey): boolean => {
  const flag = FEATURE_FLAGS[flagKey];
  if (!flag) {
    console.warn(`Feature flag ${flagKey} not found, returning false`);
    return false;
  }

  const currentEnv = getCurrentEnvironment();
  const overrides = ENVIRONMENT_OVERRIDES[currentEnv];

  // Check if there's an environment-specific override
  if (overrides && flagKey in overrides) {
    return overrides[flagKey as keyof typeof overrides];
  }

  // Check if flag is restricted to specific environment
  if (flag.environment && flag.environment !== 'all' && flag.environment !== currentEnv) {
    return false;
  }

  return flag.enabled;
};

/**
 * Get all active feature flags
 */
export const getAllActiveFeatureFlags = (): Record<string, boolean> => {
  const activeFlags: Record<string, boolean> = {};

  Object.keys(FEATURE_FLAGS).forEach((key) => {
    const flagKey = key as FeatureFlagKey;
    activeFlags[flagKey] = getFeatureFlagValue(flagKey);
  });

  return activeFlags;
};

/**
 * Feature flag metadata for debugging
 */
export const getFeatureFlagMetadata = (flagKey: FeatureFlagKey) => {
  return FEATURE_FLAGS[flagKey];
};

/**
 * Development helper to log all feature flags
 */
export const logAllFeatureFlags = () => {
  if (__DEV__) {
    console.group('🚩 Feature Flags Status');
    Object.entries(getAllActiveFeatureFlags()).forEach(([key, value]) => {
      const flag = FEATURE_FLAGS[key as FeatureFlagKey];
      console.log(`${key}: ${value ? '✅' : '❌'} (${flag?.description})`);
    });
    console.groupEnd();
  }
};