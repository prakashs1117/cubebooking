/**
 * Feature Flags Configuration
 *
 * This file defines all feature flags used in the application.
 * Feature flags allow us to control feature rollouts, perform A/B testing,
 * and safely deploy code while keeping features disabled.
 */

export interface FeatureFlag {
  key: string;
  name: string;
  description: string;
  defaultValue: boolean;
  environment?: 'development' | 'staging' | 'production' | 'all';
  enabled: boolean;
}

export type FeatureFlagKey = keyof typeof FEATURE_FLAGS;

/**
 * Feature Flags Registry
 *
 * Add new feature flags here following the naming convention:
 * - ENABLE_* for feature toggles
 * - SHOW_* for UI elements
 * - Use descriptive UPPER_SNAKE_CASE names
 */
