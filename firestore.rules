rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isStaff() {
      return isSignedIn() && userRole() in ['admin', 'coordinator'];
    }

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ── User lists (staff discovery for notification fan-out) ───────────────
    match /users/{uid} {
      allow list: if isSignedIn();
    }

    // ── Notifications (per-user sub-collection) ────────────────────────────
    // Users read/update their own; any signed-in user can create into any inbox
    // (needed so teachers can fan-out TOAD notifications to staff on booking).
    match /notifications/{uid}/items/{notifId} {
      allow read, update: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Config (maintenance mode etc — signed-in read, admin write) ───────
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Programs (public read, admin write) ────────────────────────────────
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── App settings (public read, admin write) ────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Sessions (signed-in read, admin write) ─────────────────────────────
    // Teachers read sessions to check availability.
    // Writes go through Cloud Functions (transaction) — direct writes blocked.
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Blackouts (public read, admin write) ───────────────────────────────
    match /blackouts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Schools (signed-in read, admin write) ──────────────────────────────
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Slot locks (atomic double-booking prevention) ──────────────────────
    // A slot doc existing means that hour/program is taken. The batch write
    // creates booking + slots + teacherSlots together. "allow update: if false"
    // makes Firestore deny the whole batch if any lock doc already exists.
    match /slots/{slotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Teacher-hour locks (prevents teacher booking two programs at once) ──
    match /teacherSlots/{slotId} {
      allow read: if isSignedIn()
        && resource.data.teacherId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── TOAD date slots (one doc per calendar date, atomic collision prevention)
    // Doc ID = 'YYYY-MM-DD'. Status: 'held' (10-min soft lock) | 'confirmed' (booked).
    // create: any signed-in teacher can try — batch fails if doc already exists.
    // update: only the holding teacher may upgrade held→confirmed (booking committed).
    // delete: holding teacher may release their own hold; staff can clear any.
    match /toadSlots/{date} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.teacherId == request.auth.uid
        && resource.data.status == 'held'
        && request.resource.data.status == 'confirmed';
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
      allow delete: if isStaff();
    }

    // ── Bookings ───────────────────────────────────────────────────────────
    // Teachers write bookings via writeBatch (booking + slot locks atomically).
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid || isStaff()
      );

      // Teachers create bookings via writeBatch (booking + slot locks atomically)
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid;

      // Teachers can cancel their own bookings (status → 'cancelled')
      allow update: if isSignedIn()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && request.resource.data.teacherId == resource.data.teacherId;

      // Staff (admin or coordinator) can update any booking; only admins can delete
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // ── Audit log (admin read only, append via Functions) ──────────────────
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false; // Functions only
    }
  }
}
