# Firebase Web SDK configuration.
# Copy this file to .env (or .env.dev / .env.prod) and fill in the values from
# Firebase console -> Project settings -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary needs no client-side variables: the cloud name and API key are
# returned by the getCloudinarySignature callable. Set the Cloudinary secrets
# on the functions side — see functions/.env.example.

# Cloudinary cloud name — used only to build delivery URLs in the browser.
# This value is public (it appears in every Cloudinary image URL). The API key
# and secret are NOT set here; see functions/.env.example.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Name of an UNSIGNED upload preset created in the Cloudinary console.
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
